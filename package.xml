<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bigmap_bringup</name>
  <version>0.1.0</version>
  <description>BigMap on a robot, real or simulated: the DEM of a place, EasyNav with the BigMap maps manager, RViz and the parameter files of the use cases.</description>
  <maintainer email="josemiguel.guerrero@urjc.es">José Miguel Guerrero</maintainer>
  <license>Apache-2.0</license>
  <author email="josemiguel.guerrero@urjc.es">José Miguel Guerrero</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- this repo: the maps manager -->
  <exec_depend>easynav_bigmap_maps_manager</exec_depend>
  <!-- NavMap: pointcloud_to_navmap, which makes the NavMap files of maps/ from a cloud -->
  <exec_depend>navmap_tools</exec_depend>
  <!-- EasyNav: system_main and the plugins the parameter files name -->
  <exec_depend>easynav_system</exec_depend>
  <exec_depend>easynav_sensors</exec_depend>
  <exec_depend>easynav_navmap_maps_manager</exec_depend>
  <exec_depend>easynav_bonxai_maps_manager</exec_depend>
  <exec_depend>easynav_navmap_planner</exec_depend>
  <exec_depend>easynav_navmap_localizer</exec_depend>
  <exec_depend>easynav_fusion_localizer</exec_depend>
  <exec_depend>easynav_regulated_pp_controller</exec_depend>
  <!-- RViz with the NavMap display -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>navmap_rviz_plugin</exec_depend>
  <!-- the launch file -->
  <!-- bigmap_geo.launch.py: the world of a place in Gazebo, with the Summit XL -->
  <exec_depend>easynav_playground_geo</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
